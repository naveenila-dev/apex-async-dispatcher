{
  "name": "apex-async-dispatcher",
  "private": true,
  "version": "0.1.0",
  "description": "Custom Metadata-driven Salesforce Queueable dispatcher",
  "scripts": {
    "test": "python3 scripts/validate_source.py",
    "lint": "npm run prettier:verify",
    "prettier": "prettier --write \"**/*.{cls,cmp,component,css,html,js,json,md,page,trigger,xml,yaml,yml}\"",
    "prettier:verify": "prettier --check \"**/*.{cls,cmp,component,css,html,js,json,md,page,trigger,xml,yaml,yml}\"",
    "prepare": "husky",
    "precommit": "npm test && npm run prettier:verify"
  },
  "devDependencies": {
    "@prettier/plugin-xml": "^3.4.1",
    "husky": "^9.1.7",
    "prettier": "^3.5.3",
    "prettier-plugin-apex": "^2.2.6"
  },
  "engines": {
    "node": ">=22"
  }
}
