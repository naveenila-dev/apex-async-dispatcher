<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>AAD_Valid_Delay</fullName>
    <active>true</active>
    <errorConditionFormula>OR(ISBLANK(Delay_Minutes__c), Delay_Minutes__c &lt; 0, Delay_Minutes__c &gt; 10)</errorConditionFormula>
    <errorDisplayField>Delay_Minutes__c</errorDisplayField>
    <errorMessage>Delay Minutes must be a whole number from 0 to 10.</errorMessage>
</ValidationRule>
